# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Để trống GEMINI_API_KEY thì ứng dụng vẫn chạy, chức năng AI hiện "đang tắt".

# gemini | fake (fake = trả lời giả, dùng để thử giao diện không tốn tiền)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Cơ sở dữ liệu SQLite chung (module B quản lý)
DB_PATH=data/app.db

# Nhắc nhở qua Telegram (tuỳ chọn). Tạo bot với @BotFather, lấy chat id bằng @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
